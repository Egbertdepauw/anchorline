<?xml version="1.0" encoding="utf-8"?>
<!--
  USB devices for which Android offers to open Anchorline when they are
  plugged in (USB_DEVICE_ATTACHED, see AndroidManifest.xml). Accepting
  that prompt also grants USB permission for the device.

  Matches only the Divesoft SOLO gas analyzer: VID 0xA600 / PID 0xE212,
  recorded from a real unit (#104). Values must be decimal here. Keep in
  sync with lib/analyzer/transport/solo_usb_ids.dart.

  Other CDC serial analyzers still work from the analyzer screen's
  "USB (Android)" source; they just don't trigger the open-app prompt.
-->
<resources>
    <usb-device vendor-id="42496" product-id="57874" />
</resources>
