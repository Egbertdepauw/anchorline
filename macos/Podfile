platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

# git2dart_binaries libcrypto fixup (defect #3) is handled at the .app bundle
# level by the "Fix git2dart libcrypto" Run Script build phase on the Runner
# target (macos/scripts/fix_git2dart_libcrypto.sh), NOT here. Doing it in the
# Podfile mutated the shared pub-cache on every `pod install`, which broke the
# pure-Dart libgit2 FFI tests until `flutter pub get` restored the cache. The
# build phase touches only the embedded dylibs inside the built app, leaving
# the pub-cache pristine so tests and the macOS build stay green together.

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    # Some pods (geolocator_apple's privacy-bundle target as of 14.0.x)
    # ship a podspec with `s.osx.deployment_target = '10.11'` even though
    # Xcode 26+ has dropped support for anything below 10.13. Override it
    # here so the build doesn't warn on every invocation.
    target.build_configurations.each do |config|
      # Apple's MAS validator requires deployment target >= 12.0 for
      # arm64-only submissions (which is what we ship — see ARCHS
      # block below + CLAUDE.md "git2dart_binaries arm64-only" note).
      # Pre-Monterey Macs are out of scope.
      if config.build_settings['MACOSX_DEPLOYMENT_TARGET'].to_f < 12.0
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
      end
      # Match the Runner target's arm64-only build (see
      # macos/Runner/Configs/Release.xcconfig). Without this, Pods
      # still attempt the Universal Binary x86_64 slice and fail
      # downstream of the linker rejecting git2dart_binaries' arm64-
      # only dylibs.
      config.build_settings['ARCHS'] = 'arm64'
      config.build_settings['EXCLUDED_ARCHS[sdk=macosx*]'] = 'x86_64'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
    end
  end
end
