# Sentry credentials for ./upload_sentry_dsyms.sh — COPY this file to
# sentry.env.local (which is gitignored) and fill it in. Never commit a real
# token.
#
# SENTRY_AUTH_TOKEN must be a Sentry ORG auth token: it starts with 'sntrys_',
# is ~200 chars, and needs the 'project:releases' scope. A short 32-hex value
# is NOT a token and will fail with 401. The token embeds its own region and
# self-routes, so do NOT set SENTRY_URL.
export SENTRY_AUTH_TOKEN=sntrys_REPLACE_WITH_YOUR_ORG_TOKEN

# Optional — the slugs default from pubspec.yaml's `sentry:` block. Uncomment
# to override them here.
# export SENTRY_ORG=de-spaankamer-bv
# export SENTRY_PROJECT=ccrlogger
