// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// Drives the .app bundle filename (Anchorline.app), the in-app menu bar title,
// and the CFBundleName via $(PRODUCT_NAME) substitution in Info.plist.
PRODUCT_NAME = Anchorline

// The application's bundle identifier — kept as the legacy id so existing
// signing certificates, App Store Connect records, and synced state remain valid.
PRODUCT_BUNDLE_IDENTIFIER = nl.despaankamer.ccrlogger

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Anchorline. All rights reserved.
