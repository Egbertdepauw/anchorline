<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Gas analyzer over USB (#108): lets the sandboxed app open serial
	     TTYs such as /dev/cu.usbmodem101 (Divesoft SOLO, CDC-ACM). Granted
	     by the "com.apple.security.device.serial" rule in
	     /System/Library/Sandbox/Profiles/application.sb; documented in
	     Apple's legacy Entitlement Key Reference. -->
	<key>com.apple.security.device.serial</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Phase 3 attachments: file_picker needs user-selected read/write to
	     hand the picked file to AttachmentUploader; image_picker on macOS
	     uses the same panel under the hood. Camera capture needs the
	     camera entitlement. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- flutter_secure_storage on macOS rejects all Keychain calls with
	     OSStatus -34018 ("A required entitlement isn't present") unless
	     the sandboxed app declares a keychain-access-groups entry. The
	     $(AppIdentifierPrefix) prefix makes the entry valid both for
	     unsigned dev builds (empty prefix) and for properly-signed
	     release builds (real team-id prefix). Required by Phase E's
	     SubsurfaceCredentialsSource — without it, "Save credentials"
	     fails with the -34018 PlatformException. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
