# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Android release signing — keystore + secrets stay local. The keystore
# file lives at android/upload-keystore.jks; passwords + aliases live
# in android/key.properties (see android/key.properties.example for
# the shape). Losing the keystore means losing the ability to ship
# updates to existing installs — back it up to 1Password.
android/key.properties
android/upload-keystore.jks
**/*.jks
**/*.keystore
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Golden mismatch images that flutter_test writes next to a failing test.
test/**/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Drift generated files are committed (needed for builds without build_runner)
# *.g.dart — keep in version control
# Local Claude state stays ignored; project skills are shared.
.claude/*
!.claude/skills/
.superpowers/

# Flutter screenshot dumps from `flutter screenshot` land at repo root.
flutter_*.png

# Build-time --dart-define values, including the Sentry DSN. Not strictly
# secret (Sentry DSNs are public ingest URLs designed to ship in client
# code) but kept out of the repo so it's not trivially grepable by drive-by
# observers. `dart_defines.example.json` IS committed as a template.
dart_defines.json

# Supabase deploy connection string (DB password). Local-only, sourced by
# apply_migrations.sh at deploy time. NEVER commit.
supabase/.env.deploy.local

# Sentry auth token for macos/scripts/upload_sentry_dsyms.sh. Local-only,
# NEVER commit. sentry.env.example IS committed as the template.
macos/scripts/sentry.env.local
